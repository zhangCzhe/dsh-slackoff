{
  "manifest_version": 3,
  "name": "dsh-slackoff 摸鱼伴侣",
  "version": "0.1.0",
  "description": "AI 工作时自动播放视频（B 站/YouTube），AI 中断/询问时自动暂停，并支持画中画。",
  "permissions": ["tabs", "storage", "alarms", "system.display"],
  "host_permissions": [
    "http://127.0.0.1:3080/*",
    "https://*.bilibili.com/*",
    "https://*.douyin.com/*",
    "https://*.youtube.com/*",
    "https://*.tiktok.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.reddit.com/*",
    "https://*.vimeo.com/*",
    "https://*.dailymotion.com/*",
    "https://*.twitch.tv/*"
  ],
  "background": { "service_worker": "dist/background.js" },
  "content_scripts": [
    { "matches": ["http://127.0.0.1:3080/*"], "js": ["dist/dsh-bridge.js"], "run_at": "document_idle" },
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://*.douyin.com/*",
        "https://*.youtube.com/*",
        "https://*.tiktok.com/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.reddit.com/*",
        "https://*.vimeo.com/*",
        "https://*.dailymotion.com/*",
        "https://*.twitch.tv/*"
      ],
      "js": ["dist/shadow-patch.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://*.douyin.com/*",
        "https://*.youtube.com/*",
        "https://*.tiktok.com/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.reddit.com/*",
        "https://*.vimeo.com/*",
        "https://*.dailymotion.com/*",
        "https://*.twitch.tv/*"
      ],
      "js": ["dist/site-controller.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": { "default_popup": "dist/options.html", "default_title": "dsh-slackoff 设置" },
  "options_page": "dist/options.html"
}
